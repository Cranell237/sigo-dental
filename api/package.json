{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "prisma migrate deploy && tsx prisma/seed.ts && tsx prisma/demo.ts && node dist/src/index.js",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "backup": "tsx scripts/backup.ts",
    "restaurar": "tsx scripts/backup.ts restaurar",
    "coverage": "vitest run --coverage",
    "carga": "tsx scripts/carga.ts",
    "openapi": "tsx scripts/openapi.ts",
    "demo": "tsx prisma/demo.ts",
    "e2e": "tsx scripts/e2e.ts",
    "totp": "tsx scripts/totp.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.0.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^2.1.9",
    "autocannon": "^8.0.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
