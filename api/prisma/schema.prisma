generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Los 5 roles del SRS §3 (SQLite no admite enums nativos: se guarda como texto y se valida con Zod).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String
  passwordHash String
  mfaSecret    String? // cifrado con AES-256-GCM
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// RNF-06: solo inserción. Los triggers de la migración bloquean UPDATE y DELETE;
// cada fila incluye el hash de la anterior para detectar manipulación.
model AuditLog {
  id         Int     @id @default(autoincrement())
  timestamp  String
  userId     String?
  action     String
  resource   String
  resourceId String?
  ip         String?
  prevHash   String
  hash       String
}

// Refresh tokens rotativos: se guarda solo el hash. expiresAt se renueva en cada rotación (15 min de inactividad).
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  mfa       Boolean  @default(false)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Fase 1 ----------

// RF-01: ficha única del paciente.
model Patient {
  id                 String   @id @default(cuid())
  cedula             String   @unique
  nombres            String
  apellidos          String
  fechaNacimiento    DateTime
  sexo               String
  telefono           String
  email              String?
  direccion          String?
  emergenciaNombre   String
  emergenciaTelefono String
  tutorNombre        String? // obligatorio si es menor de edad
  tutorCedula        String?
  tutorTelefono      String?
  seguro             String?
  convenio           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  anamnesis    Anamnesis?
  appointments Appointment[]
}

// RF-02: anamnesis obligatoria. `observaciones` se guarda cifrada (AES-256-GCM).
model Anamnesis {
  id            String   @id @default(cuid())
  patientId     String   @unique
  patient       Patient  @relation(fields: [patientId], references: [id])
  alergias      String // JSON: lista de alergias a fármacos
  anticoagulado Boolean  @default(false)
  coagulopatia  Boolean  @default(false)
  enfermedades  String? // enfermedades sistémicas
  cirugias      String? // antecedentes quirúrgicos
  observaciones String?
  updatedAt     DateTime @updatedAt
}

model Consultorio {
  id       String   @id @default(cuid())
  nombre   String   @unique
  sillones Sillon[]
}

model Sillon {
  id            String      @id @default(cuid())
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String

  appointments Appointment[]

  @@unique([consultorioId, nombre])
}

model Profesional {
  id           String  @id @default(cuid())
  userId       String? @unique
  nombre       String
  especialidad String

  appointments Appointment[]
}

// Precio base en centavos (nunca float).
model Procedimiento {
  id         String @id @default(cuid())
  codigo     String @unique
  nombre     String
  precioBase Int
}

// RF-09/10, RN-03.
model Appointment {
  id            String      @id @default(cuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])
  sillonId      String
  sillon        Sillon      @relation(fields: [sillonId], references: [id])
  inicio        DateTime
  fin           DateTime
  estado        String      @default("PROGRAMADO")
  motivo        String?
  createdAt     DateTime    @default(now())

  @@index([sillonId, inicio])
  @@index([inicio])
}
