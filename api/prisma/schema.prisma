generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Los 5 roles del SRS §3 (SQLite no admite enums nativos: se guarda como texto y se valida con Zod).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String
  passwordHash String
  createdAt    DateTime @default(now())
}
