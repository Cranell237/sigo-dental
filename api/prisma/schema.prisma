generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Los 5 roles del SRS §3 (SQLite no admite enums nativos: se guarda como texto y se valida con Zod).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String
  passwordHash String
  createdAt    DateTime @default(now())
}

// RNF-06: solo inserción. Los triggers de la migración bloquean UPDATE y DELETE;
// cada fila incluye el hash de la anterior para detectar manipulación.
model AuditLog {
  id         Int     @id @default(autoincrement())
  timestamp  String
  userId     String?
  action     String
  resource   String
  resourceId String?
  ip         String?
  prevHash   String
  hash       String
}
