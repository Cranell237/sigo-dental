generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Los 5 roles del SRS §3 (SQLite no admite enums nativos: se guarda como texto y se valida con Zod).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String
  passwordHash String
  mfaSecret    String? // cifrado con AES-256-GCM
  mfaEnabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// RNF-06: solo inserción. Los triggers de la migración bloquean UPDATE y DELETE;
// cada fila incluye el hash de la anterior para detectar manipulación.
model AuditLog {
  id         Int     @id @default(autoincrement())
  timestamp  String
  userId     String?
  action     String
  resource   String
  resourceId String?
  ip         String?
  prevHash   String
  hash       String
}

// Refresh tokens rotativos: se guarda solo el hash. expiresAt se renueva en cada rotación (15 min de inactividad).
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  mfa       Boolean  @default(false)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Fase 1 ----------

// RF-01: ficha única del paciente.
model Patient {
  id                 String   @id @default(cuid())
  cedula             String   @unique
  nombres            String
  apellidos          String
  fechaNacimiento    DateTime
  sexo               String
  telefono           String
  email              String?
  direccion          String?
  emergenciaNombre   String
  emergenciaTelefono String
  tutorNombre        String? // obligatorio si es menor de edad
  tutorCedula        String?
  tutorTelefono      String?
  seguro             String?
  convenio           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  anamnesis    Anamnesis?
  appointments Appointment[]
}

// RF-02: anamnesis obligatoria. `observaciones` se guarda cifrada (AES-256-GCM).
model Anamnesis {
  id            String   @id @default(cuid())
  patientId     String   @unique
  patient       Patient  @relation(fields: [patientId], references: [id])
  alergias      String // JSON: lista de alergias a fármacos
  anticoagulado Boolean  @default(false)
  coagulopatia  Boolean  @default(false)
  enfermedades  String? // enfermedades sistémicas
  cirugias      String? // antecedentes quirúrgicos
  observaciones String?
  updatedAt     DateTime @updatedAt
}

model Consultorio {
  id       String   @id @default(cuid())
  nombre   String   @unique
  sillones Sillon[]
}

model Sillon {
  id            String      @id @default(cuid())
  consultorioId String
  consultorio   Consultorio @relation(fields: [consultorioId], references: [id])
  nombre        String

  appointments Appointment[]

  @@unique([consultorioId, nombre])
}

model Profesional {
  id           String  @id @default(cuid())
  userId       String? @unique
  nombre       String
  especialidad String

  appointments Appointment[]
}

// Precio base en centavos (nunca float).
model Procedimiento {
  id         String @id @default(cuid())
  codigo     String @unique
  nombre     String
  precioBase Int
}

// RF-09/10, RN-03.
model Appointment {
  id            String      @id @default(cuid())
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  profesionalId String
  profesional   Profesional @relation(fields: [profesionalId], references: [id])
  sillonId      String
  sillon        Sillon      @relation(fields: [sillonId], references: [id])
  inicio        DateTime
  fin           DateTime
  estado        String      @default("PROGRAMADO")
  motivo        String?
  createdAt     DateTime    @default(now())

  @@index([sillonId, inicio])
  @@index([inicio])
}

// ---------- Fase 1: caja, facturación y recordatorios ----------

// RF-12 / RN-02: turno de caja. Los importes son enteros en centavos.
model CajaTurno {
  id             String    @id @default(cuid())
  userId         String
  fondoInicial   Int
  estado         String    @default("ABIERTA") // ABIERTA | CERRADA
  abiertaAt      DateTime  @default(now())
  cerradaAt      DateTime?
  conteoEfectivo Int? // lo ingresa la recepcionista a ciegas
  totalTeorico   Int? // efectivo esperado: se calcula y se revela solo al cerrar
  diferencia     Int?

  cobros Cobro[]

  @@index([userId, estado])
}

model Cobro {
  id        Int       @id @default(autoincrement())
  turnoId   String
  turno     CajaTurno @relation(fields: [turnoId], references: [id])
  patientId String
  total     Int
  createdAt DateTime  @default(now())

  lineas  CobroLinea[]
  pagos   Pago[]
  factura Factura?
}

model CobroLinea {
  id              String @id @default(cuid())
  cobroId         Int
  cobro           Cobro  @relation(fields: [cobroId], references: [id])
  procedimientoId String
  descripcion     String
  cantidad        Int
  precioUnitario  Int
}

model Pago {
  id         String  @id @default(cuid())
  cobroId    Int
  cobro      Cobro   @relation(fields: [cobroId], references: [id])
  metodo     String // EFECTIVO | TARJETA_CREDITO | TARJETA_DEBITO | TRANSFERENCIA | SEGURO
  monto      Int
  referencia String?
}

// Comprobante electrónico (XML). La autorización es simulada (adaptador del SRI).
model Factura {
  id                 String   @id @default(cuid())
  cobroId            Int      @unique
  cobro              Cobro    @relation(fields: [cobroId], references: [id])
  secuencial         Int      @unique
  claveAcceso        String   @unique
  numeroAutorizacion String
  estado             String
  xml                String
  createdAt          DateTime @default(now())
}

// RF-11: bitácora de recordatorios enviados (uno por cita y tipo).
model Recordatorio {
  id            String   @id @default(cuid())
  appointmentId String
  tipo          String // 48H | 24H
  canal         String // EMAIL | WHATSAPP | SMS
  destino       String
  mensaje       String
  sentAt        DateTime @default(now())

  @@unique([appointmentId, tipo])
}

// ---------- Fase 2: expediente clínico ----------

// RF-03 / RN-01: hallazgos del odontograma. Un hallazgo REALIZADO no se modifica ni se borra
// (triggers en la migración); las correcciones se hacen con una Adenda firmada.
model Hallazgo {
  id              String    @id @default(cuid())
  patientId       String
  diente          String // numeración FDI
  superficie      String? // M | D | O | V | L; null = diente completo
  tipo            String
  estado          String // EXISTENTE | REQUERIDO | REALIZADO
  nota            String?
  creadoPorId     String
  createdAt       DateTime  @default(now())
  realizadoAt     DateTime?
  realizadoPorId  String?
  procedimientoId String? // procedimiento del catálogo con el que se realizó (descargo de insumos y honorarios)

  adendas Adenda[]

  @@index([patientId])
}

// RF-05: nota de evolución SOEP. Los cuatro campos se guardan cifrados.
model NotaSoep {
  id            String    @id @default(cuid())
  patientId     String
  appointmentId String?
  autorId       String
  subjetivo     String
  objetivo      String
  evaluacion    String
  plan          String
  createdAt     DateTime  @default(now())
  firmadaAt     DateTime?
  firmadaPorId  String?
  firmaHash     String?

  adendas Adenda[]

  @@index([patientId, createdAt])
}

// Corrección firmada de una nota o de un hallazgo. Solo inserción.
model Adenda {
  id         String    @id @default(cuid())
  notaId     String?
  nota       NotaSoep? @relation(fields: [notaId], references: [id])
  hallazgoId String?
  hallazgo   Hallazgo? @relation(fields: [hallazgoId], references: [id])
  texto      String
  autorId    String
  firmaHash  String
  createdAt  DateTime  @default(now())
}

// RF-04: cada examen periodontal es un registro nuevo (no se edita). `puntos` es JSON con 6 sitios por diente.
model PerioExamen {
  id        String   @id @default(cuid())
  patientId String
  autorId   String
  createdAt DateTime @default(now())

  dientes PerioDiente[]

  @@index([patientId, createdAt])
}

model PerioDiente {
  id        String      @id @default(cuid())
  examenId  String
  examen    PerioExamen @relation(fields: [examenId], references: [id])
  diente    String
  puntos    String
  furca     Int         @default(0)
  movilidad Int         @default(0)
}

// ---------- Fase 2: consentimientos, recetas y presupuestos ----------

// RF-06: plantilla de consentimiento por procedimiento (procedimientoId nulo = genérica).
model ConsentimientoPlantilla {
  id              String  @id @default(cuid())
  procedimientoId String?
  titulo          String
  texto           String
}

// El texto se copia al consentimiento (snapshot) para que firmar sea inmutable aunque cambie la plantilla.
model Consentimiento {
  id             String    @id @default(cuid())
  patientId      String
  titulo         String
  texto          String
  metodo         String // FIRMA | OTP
  otpHash        String?
  otpExpira      DateTime?
  estado         String    @default("PENDIENTE") // PENDIENTE | FIRMADO
  firmanteNombre String? // el paciente o, si es menor, su tutor legal
  pdfPath        String?
  pdfHash        String?
  creadoPorId    String
  createdAt      DateTime  @default(now())
  firmadoAt      DateTime?

  @@index([patientId])
}

// §8.1: recetas odontológicas en PDF.
model Receta {
  id          String   @id @default(cuid())
  patientId   String
  autorId     String
  diagnostico String?
  items       String // JSON: [{ medicamento, dosis, frecuencia, duracion, indicaciones }]
  pdfPath     String
  createdAt   DateTime @default(now())

  @@index([patientId])
}

// RF-07/08: presupuesto por fases y sesiones. Importes en centavos.
model Presupuesto {
  id              String    @id @default(cuid())
  patientId       String
  autorId         String
  estado          String    @default("BORRADOR") // BORRADOR | PRESENTADO | APROBADO | APROBADO_PARCIAL | RECHAZADO
  descuento       Int       @default(0)
  autorizadoPorId String? // quien autorizó el descuento
  createdAt       DateTime  @default(now())
  aprobadoAt      DateTime?

  items PresupuestoItem[]

  @@index([patientId])
}

model PresupuestoItem {
  id               String      @id @default(cuid())
  presupuestoId    String
  presupuesto      Presupuesto @relation(fields: [presupuestoId], references: [id])
  fase             Int
  sesion           Int
  procedimientoId  String
  descripcion      String
  diente           String?
  cantidad         Int
  precioUnitario   Int
  honorario        Int // parte del precio que corresponde al profesional (RF-13)
  costoLaboratorio Int         @default(0)
  estado           String      @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO | AGENDADO
  appointmentId    String?
}

// ---------- Fase 3: inventario, honorarios y reportes ----------

model Insumo {
  id            String @id @default(cuid())
  codigo        String @unique
  nombre        String
  unidad        String // pieza, ml, g…
  stockMinimo   Int    @default(0)
  costoUnitario Int    @default(0) // centavos por unidad
}

// Stock por consultorio y lote. `cantidad` es el saldo actual; los cambios quedan en MovimientoInventario.
model LoteInsumo {
  id            String    @id @default(cuid())
  insumoId      String
  consultorioId String
  lote          String
  vence         DateTime?
  cantidad      Int
  createdAt     DateTime  @default(now())

  @@unique([insumoId, consultorioId, lote])
  @@index([insumoId, consultorioId])
}

// Bitácora de movimientos: solo inserción.
model MovimientoInventario {
  id            String   @id @default(cuid())
  insumoId      String
  consultorioId String
  loteId        String?
  tipo          String // ENTRADA | SALIDA | AJUSTE
  cantidad      Int // positiva; el tipo indica el sentido (en AJUSTE, la diferencia con signo va en `motivo`)
  motivo        String
  hallazgoId    String? // procedimiento que originó un descargo automático
  userId        String
  createdAt     DateTime @default(now())

  @@index([insumoId, consultorioId])
}

// RF-14: receta estándar de consumo por procedimiento.
model RecetaConsumo {
  id              String @id @default(cuid())
  procedimientoId String
  insumoId        String
  cantidad        Int

  @@unique([procedimientoId, insumoId])
}

// RF-13: regla de honorarios. valor = puntos básicos (4000 = 40,00 %) o centavos según la modalidad.
model ReglaHonorario {
  id              String  @id @default(cuid())
  profesionalId   String
  procedimientoId String? // nulo = regla general del profesional
  modalidad       String // PORCENTAJE | MONTO_FIJO | PORCENTAJE_NETO
  valor           Int

  @@index([profesionalId])
}

// Instantánea inmutable de lo realizado (precio y costos al momento), base de la liquidación.
model ProcedimientoRealizado {
  id               String   @id @default(cuid())
  hallazgoId       String   @unique
  patientId        String
  profesionalId    String?
  procedimientoId  String
  consultorioId    String?
  precio           Int
  costoMateriales  Int      @default(0)
  costoLaboratorio Int      @default(0)
  realizadoAt      DateTime
  liquidacionId    String?

  @@index([profesionalId, realizadoAt])
}

model Liquidacion {
  id            String   @id @default(cuid())
  profesionalId String
  desde         DateTime
  hasta         DateTime
  total         Int
  creadaPorId   String
  createdAt     DateTime @default(now())

  lineas LiquidacionLinea[]
}

model LiquidacionLinea {
  id            String      @id @default(cuid())
  liquidacionId String
  liquidacion   Liquidacion @relation(fields: [liquidacionId], references: [id])
  realizadoId   String
  descripcion   String
  base          Int
  modalidad     String
  valor         Int
  comision      Int
}
